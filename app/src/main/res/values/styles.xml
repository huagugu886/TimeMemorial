<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 底部导航文字样式 -->
    <style name="BottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <!-- MiUIX 胶囊指示器样式 -->
    <style name="MiuiCapsuleIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/miuix_indicator_color</item>
        <item name="shapeAppearance">@style/MiuiCapsuleShape</item>
    </style>

    <style name="MiuiCapsuleShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>
